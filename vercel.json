{
  "regions": ["sin1"],
  "builds": [
    { "src": "repo-check/index.html", "use": "@vercel/static" },
    { "src": "repo-check/api/data.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "^/api/data(.*)$", "dest": "repo-check/api/data.js" },
    { "src": "^/(.*)$", "dest": "repo-check/index.html" }
  ]
}
